{
  "uid": "logs-overview",
  "title": "Logs overview",
  "tags": [
    "logs",
    "observability-platform"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "description": "Logs of every project from Elasticsearch. Managed by observability-platform/install/logging/grafana-setup.",
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "logs-elasticsearch"
        },
        "query": "{\"find\": \"terms\", \"field\": \"project\", \"query\": \"*\"}",
        "definition": "{\"find\": \"terms\", \"field\": \"project\", \"query\": \"*\"}",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "logs-elasticsearch"
        },
        "query": "{\"find\": \"terms\", \"field\": \"cluster\", \"query\": \"project:$project\"}",
        "definition": "{\"find\": \"terms\", \"field\": \"cluster\", \"query\": \"project:$project\"}",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "logs-elasticsearch"
        },
        "query": "{\"find\": \"terms\", \"field\": \"service\", \"query\": \"project:$project AND cluster:$cluster\"}",
        "definition": "{\"find\": \"terms\", \"field\": \"service\", \"query\": \"project:$project AND cluster:$cluster\"}",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "* OR (NOT _exists_:service)",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,fatal,warn,info,debug",
        "multi": true,
        "includeAll": true,
        "allValue": "* OR (NOT _exists_:level)",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "error",
            "value": "error"
          },
          {
            "selected": false,
            "text": "fatal",
            "value": "fatal"
          },
          {
            "selected": false,
            "text": "warn",
            "value": "warn"
          },
          {
            "selected": false,
            "text": "info",
            "value": "info"
          },
          {
            "selected": false,
            "text": "debug",
            "value": "debug"
          }
        ]
      },
      {
        "name": "search",
        "label": "Search (Lucene, e.g. message:payment or request_id:abc-123)",
        "type": "textbox",
        "query": "*",
        "current": {
          "text": "*",
          "value": "*"
        }
